end

local function CloneMe(char)
    if not char then return nil end
    char.Archivable = true
    local clone = char:Clone()
    char.Archivable = false
    return clone
end

local function setupCharacter(character)
    if hasAppliedHackLord then return end
    hasAppliedHackLord = true
    task.wait(1.5)

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        task.wait(1)
        humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            return
        end
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if animator then animator:Destroy() end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then child:Destroy() end
    end
    for _, child in ipairs(humanoid:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") then
            child:Destroy()
        end
    end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") or child:IsA("Accessory") then
            child:Destroy()
        end
    end
    for _, child in ipairs(character:GetDescendants()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("TShirt") or child:IsA("Accessory") then
            child:Destroy()
        end
    end

    local bodyPartNames = {
        "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm",
        "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg",
        "RightUpperLeg", "RightLowerLeg", "LeftFoot", "RightFoot"
    }
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= character:FindFirstChild("HumanoidRootPart") then
            local isBody = false
            for _, name in ipairs(bodyPartNames) do
                if part.Name == name then isBody = true break end
            end
            if isBody then
                local isTorso = (part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso")
                part.Color = isTorso and Color3.fromRGB(50, 150, 50) or Color3.new(0,0,0)
                part.Material = Enum.Material.SmoothPlastic
                if part.Name == "Head" then
                else
                    for _, child in ipairs(part:GetChildren()) do
                        if child:IsA("SpecialMesh") then child:Destroy() end
                    end
                    part.Shape = Enum.PartType.Block
                end
            end
        end
    end

    local success, model = pcall(function() return game:GetObjects("rbxassetid://102473641596712")[1] end)
    if success and model then
        local hackLord = model:FindFirstChild("HackLord")
        if hackLord then
            local hackLordHead = hackLord:FindFirstChild("Head")
            local referencePart = hackLord.PrimaryPart
            if not referencePart then
                for _, p in ipairs(hackLord:GetDescendants()) do
                    if p:IsA("BasePart") then referencePart = p break end
                end
            end
            if referencePart then
                local components = {
                    ExtraModels = hackLord:FindFirstChild("ExtraModels"),
                    Coffin = hackLord:FindFirstChild("Coffin"),
                    ErlkingCoffinChains = hackLord:FindFirstChild("ErlkingCoffinChains"),
                    HaxxedCrown = hackLord:FindFirstChild("Haxxed Crown")
                }
                for name, component in pairs(components) do
                    if component then
                        if component:IsA("Model") then
                            for _, part in ipairs(component:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    local relCF = getRelativeCFrame(part, referencePart)
                                    weldToCharacter(character, part, character.HumanoidRootPart, relCF, true)
                                end
                            end
                        elseif component:IsA("BasePart") then
                            local relCF = getRelativeCFrame(component, referencePart)
                            if name == "ErlkingCoffinChains" then
                                local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
                                if torso then weldToCharacter(character, component, torso, relCF, false)
                                else weldToCharacter(character, component, character.HumanoidRootPart, relCF, false) end
                            elseif name == "HaxxedCrown" then
                                weldToCharacter(character, component, character.Head, relCF, false, CFrame.new(0, -1.5, 0))
                            else
                                weldToCharacter(character, component, character.HumanoidRootPart, relCF, true)
                            end
                        end
                    end
                end
                if hackLordHead then
                    for _, att in ipairs(hackLordHead:GetChildren()) do
                        if att:IsA("Attachment") then moveAttachmentToPlayerHead(character, att, hackLordHead) end
                    end
                end
                local animSaves = hackLord:FindFirstChild("AnimSaves")
                if animSaves then
                    local safeFolder = createSafeFolder()
                    for _, anim in ipairs(animSaves:GetChildren()) do
                        if anim:IsA("KeyframeSequence") then
                            local clone = anim:Clone()
                            clone.Parent = safeFolder
                        end
                    end
                end
            end
        end
        model:Destroy()
